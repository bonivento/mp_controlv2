# Copia este archivo a .env.local (no se sube a git) y ajusta los valores.
# Las variables NEXT_PUBLIC_* se incrustan al compilar: reinicia `npm run dev`
# o vuelve a hacer `npm run build` después de cambiarlas.

# --- Supabase (modo real) -----------------------------------------------------
# Proyecto de Supabase: Settings > API. Solo la clave pública (anon); la web
# nunca usa una clave de servicio, la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Modo de demostración local (sin Supabase) --------------------------------
# 1 = el acceso y los datos viven en el localStorage del navegador, detrás de la
# misma interfaz que Supabase. Sirve para revisar la interfaz sin base de datos.
# Si vale 1 se ignoran las variables de Supabase. En modo real va en 0 (o se omite).
# No usar en producción.
NEXT_PUBLIC_DEMO_MODE=0

# --- API de cálculo -------------------------------------------------------------
# 1 = el cliente devuelve respuestas de ejemplo (web/lib/fixtures/) en lugar de
# llamar a /api/*; los números NO vienen de la API y cada respuesta lo advierte.
# En modo real va en 0 (o se omite).
NEXT_PUBLIC_API_MOCK=0

# Destino del rewrite /api/:path* -> ${API_URL}/api/:path* (lado servidor, sin
# NEXT_PUBLIC_). Local: uvicorn en el puerto 8000 (o el que uses). Producción: URL
# del proyecto cep-api. La API exige el JWT de Supabase; con AUTH_DISABLED=1 en la
# API (solo pruebas locales) lo ignora, pero la web lo envía siempre.
API_URL=http://localhost:8000
