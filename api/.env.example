# Variables de la API (api/). Copie este archivo a `.env.local` para desarrollo local;
# `.env.local` no se sube a git. En Vercel se definen en Project Settings > Environment Variables.

# URL del proyecto de Supabase. De aquí salen las claves públicas con las que se verifica
# el JWT de cada petición: {SUPABASE_URL}/auth/v1/.well-known/jwks.json (firma ES256).
# Obligatoria salvo con AUTH_DISABLED=1.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Solo desarrollo local: con 1 la API NO verifica el token y acepta cualquier petición.
# Nunca la defina en producción (si VERCEL_ENV=production la API la ignora).
# AUTH_DISABLED=1

# Orígenes del navegador autorizados (CORS), separados por coma. Por defecto la web local.
# En producción, con web y API bajo el mismo dominio, no hace falta.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
