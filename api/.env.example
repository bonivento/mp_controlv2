# Variables de la API (api/). Copie este archivo a `.env.local` para desarrollo local;
# `.env.local` no se sube a git. En Vercel se definen en Project Settings > Environment Variables.

# URL del proyecto de Supabase. De aquí salen las claves públicas con las que se verifica
# el JWT de cada petición: {SUPABASE_URL}/auth/v1/.well-known/jwks.json (firma ES256).
# Obligatoria salvo con AUTH_DISABLED=1.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Solo desarrollo local: con 1 la API NO verifica el token y acepta cualquier petición.
# Nunca la defina en producción (si VERCEL_ENV=production la API la ignora).
# AUTH_DISABLED=1

# Orígenes del navegador autorizados (CORS), separados por coma. Por defecto la web local.
# En producción, con web y API bajo el mismo dominio, no hace falta.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Asistente con IA (api/app/routers/assistant.py) ---
# Credencial de la API de Anthropic. Sin ella el asistente se desactiva (GET /api/assistant/status
# responde enabled=false y el chat responde 503). Nunca en git: solo en .env.local o en Vercel.
# ANTHROPIC_API_KEY=

# Modelo del asistente. Por defecto claude-opus-5-5.
# ASSISTANT_MODEL=claude-opus-5-5

# Esfuerzo de razonamiento: low, medium, high, xhigh o max. Por defecto medium (más alto = más lento y caro).
# ASSISTANT_EFFORT=medium

# Máximo de tokens de salida por respuesta (256 a 16000). Por defecto 4000.
# ASSISTANT_MAX_TOKENS=4000

# Con 1, las sesiones de invitado (usuarios anónimos de Supabase) pueden usar el asistente. Por defecto no:
# cada invitado nuevo sería una cuota de IA gratis para cualquiera.
# ASSISTANT_ALLOW_GUESTS=0

# Tiempo máximo en segundos de una consulta (varias llamadas al modelo). Por defecto 240; mantenerlo por
# debajo de la duración máxima de la función en Vercel.
# ASSISTANT_TIME_BUDGET=240
